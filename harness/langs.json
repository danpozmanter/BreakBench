{
  "c": {
    "name": "C",
    "homepage": "https://www.open-std.org/jtc1/sc22/wg14/",
    "service": "c",
    "ext": "c",
    "file": "main.c",
    "build": [
      "clang -std=c23 -O0 -g -pthread -o main main.c"
    ],
    "run": "./main",
    "version": "clang --version | head -1",
    "release": {
      "build": [
        "clang -std=c23 -O3 -DNDEBUG -pthread -o main main.c"
      ],
      "run": "./main"
    },
    "tools": {
      "check": [
        "clang -std=c23 -Weverything -Wno-declaration-after-statement -Wno-unsafe-buffer-usage -Wno-c++98-compat -Wno-c++98-compat-pedantic -Wno-pre-c23-compat -Wno-padded -fsyntax-only main.c",
        "clang -std=c23 --analyze -Xanalyzer -analyzer-output=text -o /dev/null main.c"
      ],
      "sanitize": {
        "build": [
          "clang -std=c23 -O0 -g -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -pthread -o main main.c"
        ],
        "run": "./main"
      }
    }
  },
  "cpp": {
    "name": "C++",
    "homepage": "https://isocpp.org/",
    "repository": "https://github.com/cplusplus/draft",
    "service": "cpp",
    "ext": "cpp",
    "file": "main.cpp",
    "build": [
      "clang++ -std=c++23 -O0 -g -D_GLIBCXX_ASSERTIONS -pthread -o main main.cpp -lstdc++exp"
    ],
    "run": "./main",
    "version": "clang++ --version | head -1",
    "release": {
      "build": [
        "clang++ -std=c++23 -O3 -DNDEBUG -pthread -o main main.cpp -lstdc++exp"
      ],
      "run": "./main"
    },
    "tools": {
      "check": [
        "clang++ -std=c++23 -Weverything -Wno-declaration-after-statement -Wno-unsafe-buffer-usage -Wno-c++98-compat -Wno-c++98-compat-pedantic -Wno-pre-c23-compat -Wno-padded -D_GLIBCXX_ASSERTIONS -fsyntax-only main.cpp",
        "clang++ -std=c++23 --analyze -Xanalyzer -analyzer-output=text -o /dev/null main.cpp"
      ],
      "sanitize": {
        "build": [
          "clang++ -std=c++23 -O0 -g -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -D_GLIBCXX_ASSERTIONS -pthread -o main main.cpp -lstdc++exp"
        ],
        "run": "./main"
      }
    }
  },
  "rust": {
    "name": "Rust",
    "homepage": "https://www.rust-lang.org/",
    "repository": "https://github.com/rust-lang/rust",
    "service": "rust",
    "ext": "rs",
    "file": "main.rs",
    "build": [
      "rustc --edition 2024 -g --extern regex=/opt/rustdeps/libregex.rlib -L dependency=/opt/rustdeps/lib -o main main.rs"
    ],
    "run": "./main",
    "version": "rustc --version",
    "release": {
      "build": [
        "rustc --edition 2024 -C opt-level=3 --extern regex=/opt/rustdeps/libregex.rlib -L dependency=/opt/rustdeps/lib -o main main.rs"
      ],
      "run": "./main"
    },
    "tools": {
      "check": [
        "clippy-driver --edition 2024 -W clippy::pedantic --extern regex=/opt/rustdeps/libregex.rlib -L dependency=/opt/rustdeps/lib -o main_clippy main.rs"
      ],
      "unrelated": {
        "panic_under_lock": "clippy's manual_assert asks for assert! in place of if and panic!; it says nothing about the half-updated ledger"
      }
    }
  },
  "zig": {
    "name": "Zig",
    "homepage": "https://ziglang.org/",
    "repository": "https://codeberg.org/ziglang/zig",
    "service": "zig",
    "ext": "zig",
    "file": "main.zig",
    "build": [
      "zig build-exe -O Debug -freference-trace=64 -femit-bin=main main.zig"
    ],
    "run": "./main",
    "version": "zig version",
    "release": {
      "build": [
        "zig build-exe -O ReleaseSafe -femit-bin=main main.zig"
      ],
      "run": "./main"
    }
  },
  "golang": {
    "name": "Go",
    "homepage": "https://go.dev/",
    "repository": "https://go.googlesource.com/go",
    "service": "golang",
    "ext": "go",
    "file": "main.go",
    "build": [
      "cp /opt/gomod/go.mod /opt/gomod/go.sum . && GOFLAGS=-buildvcs=false go build -o main main.go"
    ],
    "run": "./main",
    "version": "go version",
    "tools": {
      "check": [
        "GOFLAGS=-buildvcs=false go vet main.go"
      ],
      "sanitize": {
        "build": [
          "cp /opt/gomod/go.mod /opt/gomod/go.sum . && GOFLAGS=-buildvcs=false go build -race -o main main.go"
        ],
        "run": "./main"
      }
    }
  },
  "swift": {
    "name": "Swift",
    "homepage": "https://www.swift.org/",
    "repository": "https://github.com/swiftlang/swift",
    "service": "swift",
    "ext": "swift",
    "file": "main.swift",
    "build": [
      "swiftc -swift-version 6 -strict-memory-safety -Onone -g -I /opt/swiftdeps/.build/debug -o main main.swift /opt/swiftdeps/.build/debug/libDeps.a -lstdc++"
    ],
    "run": "./main",
    "version": "swiftc --version 2>&1 | head -1",
    "release": {
      "build": [
        "swiftc -swift-version 6 -O -I /opt/swiftdeps/.build/debug -o main main.swift /opt/swiftdeps/.build/debug/libDeps.a -lstdc++"
      ],
      "run": "./main"
    },
    "tools": {
      "sanitize": {
        "build": [
          "swiftc -swift-version 6 -strict-memory-safety -Onone -g -sanitize=address -I /opt/swiftdeps/.build/debug -o main main.swift /opt/swiftdeps/.build/debug/libDeps.a -lstdc++"
        ],
        "run": "./main"
      }
    }
  },
  "crystal": {
    "name": "Crystal",
    "homepage": "https://crystal-lang.org/",
    "repository": "https://github.com/crystal-lang/crystal",
    "service": "crystal",
    "ext": "cr",
    "file": "main.cr",
    "build": [
      "crystal build --error-trace -o main main.cr"
    ],
    "run": "./main",
    "version": "crystal --version | head -1",
    "release": {
      "build": [
        "crystal build --release -o main main.cr"
      ],
      "run": "./main"
    }
  },
  "d": {
    "name": "D",
    "homepage": "https://dlang.org/",
    "repository": "https://github.com/dlang/dmd",
    "service": "d",
    "ext": "d",
    "file": "main.d",
    "build": [
      "ldc2 -g -L--export-dynamic -of=main main.d"
    ],
    "run": "./main",
    "version": "ldc2 --version | head -1",
    "release": {
      "build": [
        "ldc2 -O -release -L--export-dynamic -of=main main.d"
      ],
      "run": "./main"
    },
    "tools": {
      "check": [
        "ldc2 -wi -o- main.d"
      ],
      "sanitize": {
        "build": [
          "ldc2 -g -fsanitize=address -L--export-dynamic -of=main main.d"
        ],
        "run": "./main"
      }
    }
  },
  "nim": {
    "name": "Nim",
    "homepage": "https://nim-lang.org/",
    "repository": "https://github.com/nim-lang/Nim",
    "service": "nim",
    "ext": "nim",
    "file": "main.nim",
    "build": [
      "nim c --cc:clang --threads:on --hints:off --verbosity:0 -o:main main.nim"
    ],
    "run": "./main",
    "version": "nim --version | head -1",
    "release": {
      "build": [
        "nim c -d:release --cc:clang --threads:on --hints:off --verbosity:0 -o:main main.nim"
      ],
      "run": "./main"
    },
    "tools": {
      "check": [
        "nim check --threads:on --hints:off main.nim"
      ]
    }
  },
  "v": {
    "name": "V",
    "homepage": "https://vlang.io/",
    "repository": "https://github.com/vlang/v",
    "service": "v",
    "ext": "v",
    "file": "main.v",
    "build": [
      "v -cc clang -o main main.v"
    ],
    "run": "./main",
    "version": "v version",
    "release": {
      "build": [
        "v -prod -cc clang -o main main.v"
      ],
      "run": "./main"
    },
    "tools": {
      "check": [
        "v vet main.v"
      ]
    }
  },
  "odin": {
    "name": "Odin",
    "homepage": "https://odin-lang.org/",
    "repository": "https://github.com/odin-lang/Odin",
    "service": "odin",
    "ext": "odin",
    "file": "main.odin",
    "build": [
      "odin build main.odin -file -debug -vet -vet-cast -vet-nil-deref -vet-uninitialized -vet-using-param -vet-atomic-access -out:main"
    ],
    "run": "./main",
    "version": "odin version",
    "release": {
      "build": [
        "odin build main.odin -file -o:speed -out:main"
      ],
      "run": "./main"
    },
    "tools": {
      "sanitize": {
        "build": [
          "odin build main.odin -file -debug -vet -vet-cast -vet-nil-deref -vet-uninitialized -vet-using-param -vet-atomic-access -sanitize:address -out:main"
        ],
        "run": "./main"
      },
      "unrelated": {
        "null_byte_path": "LeakSanitizer reports an allocation never freed; it says nothing about the NUL byte that cuts the path short"
      }
    }
  },
  "c3": {
    "name": "C3",
    "homepage": "https://c3-lang.org/",
    "repository": "https://github.com/c3lang/c3c",
    "service": "c3",
    "ext": "c3",
    "file": "main.c3",
    "build": [
      "c3c compile -O0 --validation=strict -o main main.c3"
    ],
    "run": "./main",
    "version": "c3c --version | head -1",
    "release": {
      "build": [
        "c3c compile -O1 -o main main.c3"
      ],
      "run": "./main"
    },
    "tools": {
      "sanitize": {
        "build": [
          "c3c compile -O0 --validation=strict --sanitize=address -o main main.c3"
        ],
        "run": "./main"
      },
      "unrelated": {
        "discarded_pure_result": "LeakSanitizer reports the discarded string's allocation as a leak; it does not say the result was thrown away"
      }
    }
  },
  "mojo": {
    "name": "Mojo",
    "homepage": "https://www.modular.com/mojo",
    "repository": "https://github.com/modular/modular",
    "service": "mojo",
    "ext": "mojo",
    "file": "main.mojo",
    "build": [
      "pixi run --manifest-path /opt/mojo-ws/pixi.toml mojo build -O0 -D ASSERT=all -o main main.mojo"
    ],
    "run": "./main",
    "version": "pixi run --manifest-path /opt/mojo-ws/pixi.toml mojo --version 2>/dev/null",
    "release": {
      "build": [
        "pixi run --manifest-path /opt/mojo-ws/pixi.toml mojo build -o main main.mojo"
      ],
      "run": "./main"
    },
    "tools": {
      "unrelated": {
        "child_exit_status": "the unused value is the command's output text; Mojo's run returns no exit status for it to warn about"
      }
    }
  },
  "gossamer": {
    "name": "Gossamer",
    "homepage": "https://gossamer-lang.org/",
    "repository": "https://github.com/gossamer-lang/gossamer",
    "service": "gossamer",
    "ext": "gos",
    "file": "main.gos",
    "build": [
      "gos build main.gos"
    ],
    "run": "./target/debug/main",
    "version": "gos --version",
    "release": {
      "build": [
        "gos build --release main.gos"
      ],
      "run": "./target/release/main"
    },
    "tools": {
      "check": [
        "gos lint main.gos"
      ]
    }
  },
  "goose": {
    "name": "Goose",
    "homepage": "https://github.com/aardappel/goose",
    "repository": "https://github.com/aardappel/goose",
    "service": "goose",
    "ext": "goose",
    "file": "main.goose",
    "build": [
      "goose --debug --standalone -o main.c main.goose",
      "cc -g -O0 -w main.c -o main -lm -pthread"
    ],
    "run": "./main",
    "version": "cd /opt/goose && echo goose $(git rev-parse --short HEAD)",
    "release": {
      "build": [
        "goose --standalone -o main.c main.goose && cc -O2 -w main.c -o main -lm -pthread"
      ],
      "run": "./main"
    }
  },
  "java": {
    "name": "Java",
    "homepage": "https://dev.java/",
    "repository": "https://github.com/openjdk/jdk",
    "service": "java",
    "ext": "java",
    "file": "Main.java",
    "build": [
      "javac -d out Main.java"
    ],
    "run": "java -ea -cp out Main",
    "version": "java -version 2>&1 | head -1",
    "release": {
      "build": [
        "javac -d out Main.java"
      ],
      "run": "java -cp out Main"
    },
    "tools": {
      "check": [
        "javac -Xlint:all -d out_lint Main.java"
      ]
    }
  },
  "kotlin": {
    "name": "Kotlin",
    "homepage": "https://kotlinlang.org/",
    "repository": "https://github.com/JetBrains/kotlin",
    "service": "kotlin",
    "ext": "kt",
    "file": "main.kt",
    "build": [
      "kotlinc -progressive main.kt -cp $(ls /opt/kotlinx/*.jar | tr '\\n' ':') -include-runtime -d main.jar 2>&1 | grep -v '^warning' ; test -f main.jar"
    ],
    "run": "java -ea -cp main.jar:$(ls /opt/kotlinx/*.jar | tr '\\n' ':') MainKt",
    "version": "kotlinc -version 2>&1 | tail -1",
    "release": {
      "build": [
        "kotlinc main.kt -cp $(ls /opt/kotlinx/*.jar | tr '\\n' ':') -include-runtime -d main.jar 2>&1 | grep -v '^warning' ; test -f main.jar"
      ],
      "run": "java -cp main.jar:$(ls /opt/kotlinx/*.jar | tr '\\n' ':') MainKt"
    },
    "tools": {
      "check": [
        "kotlinc -Wextra -progressive main.kt -cp $(ls /opt/kotlinx/*.jar | tr '\\n' ':') -d lint_out"
      ]
    }
  },
  "scala": {
    "name": "Scala",
    "homepage": "https://www.scala-lang.org/",
    "repository": "https://github.com/scala/scala3",
    "service": "scala",
    "ext": "scala",
    "file": "main.scala",
    "build": [
      "mkdir -p out && scalac -cp /opt/scalaxml/scala-xml.jar -d out main.scala"
    ],
    "run": "java -ea -cp out:/opt/scalaxml/scala-xml.jar:$(find /opt/scala/maven2 -name \"scala*-library*.jar\" | tr \"\\n\" \":\") Main",
    "version": "scalac -version 2>&1 | tail -1",
    "release": {
      "build": [
        "mkdir -p out && scalac -cp /opt/scalaxml/scala-xml.jar -d out main.scala"
      ],
      "run": "java -cp out:/opt/scalaxml/scala-xml.jar:$(find /opt/scala/maven2 -name \"scala*-library*.jar\" | tr \"\\n\" \":\") Main"
    },
    "tools": {
      "check": [
        "mkdir -p out_lint && scalac -Wall -deprecation -feature -unchecked -Wnonunit-statement -Wvalue-discard -Wsafe-init -Wimplausible-patterns -Wtostring-interpolated -Wshadow:all -Wunused:all -cp /opt/scalaxml/scala-xml.jar -d out_lint main.scala"
      ]
    }
  },
  "csharp": {
    "name": "C#",
    "homepage": "https://learn.microsoft.com/dotnet/csharp/",
    "repository": "https://github.com/dotnet/roslyn",
    "service": "csharp",
    "ext": "cs",
    "file": "Program.cs",
    "extra_files": {
      "bb.csproj": "<Project Sdk=\"Microsoft.NET.Sdk\"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net11.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>false</AllowUnsafeBlocks><CheckForOverflowUnderflow>true</CheckForOverflowUnderflow></PropertyGroup></Project>"
    },
    "build": [
      "dotnet build -c Debug -o out -nologo -v minimal -clp:NoSummary"
    ],
    "run": "dotnet out/bb.dll",
    "version": "dotnet --version",
    "release": {
      "build": [
        "dotnet build -c Release -p:CheckForOverflowUnderflow=false -o out -nologo -v minimal -clp:NoSummary"
      ],
      "run": "dotnet out/bb.dll"
    },
    "tools": {
      "check": [
        "dotnet build --no-incremental -c Debug -o out_lint -nologo -v minimal -clp:NoSummary -p:AnalysisMode=All -p:WarningLevel=9999"
      ],
      "unrelated": {
        "parse_invalid_number": "CA1305 asks for an explicit culture on the parse or format call; it says nothing about the bug",
        "format_string": "CA1305 asks for an explicit culture on the parse or format call; it says nothing about the bug",
        "orphaned_receive": "CA1305 asks for an explicit culture on the parse or format call; it says nothing about the bug",
        "parse_out_of_range": "CA1305 asks for an explicit culture on the parse or format call; it says nothing about the bug",
        "cleanup_on_error_path": "CA1305 asks for an explicit culture on the parse or format call; it says nothing about the bug",
        "not_found_sentinel": "CA1846 prefers AsSpan over Substring for speed; it says nothing about the -1 the search returned"
      }
    }
  },
  "fsharp": {
    "name": "F#",
    "homepage": "https://fsharp.org/",
    "repository": "https://github.com/dotnet/fsharp",
    "service": "fsharp",
    "ext": "fs",
    "file": "Program.fs",
    "extra_files": {
      "bb.fsproj": "<Project Sdk=\"Microsoft.NET.Sdk\"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net11.0</TargetFramework><OtherFlags>--checked+</OtherFlags><Nullable>enable</Nullable></PropertyGroup><ItemGroup><Compile Include=\"Program.fs\" /></ItemGroup></Project>"
    },
    "build": [
      "dotnet build -c Debug -o out -nologo -v minimal -clp:NoSummary"
    ],
    "run": "dotnet out/bb.dll",
    "version": "dotnet --version",
    "release": {
      "build": [
        "dotnet build -c Release -p:OtherFlags= -o out -nologo -v minimal -clp:NoSummary"
      ],
      "run": "dotnet out/bb.dll"
    }
  },
  "dart": {
    "name": "Dart",
    "homepage": "https://dart.dev/",
    "repository": "https://github.com/dart-lang/sdk",
    "service": "dart",
    "ext": "dart",
    "file": "main.dart",
    "build": [
      "dart compile kernel -o main.dill main.dart"
    ],
    "run": "dart --enable-asserts main.dill",
    "version": "dart --version 2>&1",
    "release": {
      "build": [
        "dart compile exe -o main main.dart"
      ],
      "run": "./main"
    },
    "tools": {
      "check": [
        "cp -r /opt/dartlints/.dart_tool /opt/dartlints/pubspec.yaml . && printf 'include: package:lints/recommended.yaml\\nanalyzer:\\n  language:\\n    strict-casts: true\\n    strict-inference: true\\n    strict-raw-types: true\\n' > analysis_options.yaml && dart analyze --no-fatal-warnings main.dart"
      ]
    }
  },
  "typescript": {
    "name": "TypeScript",
    "homepage": "https://www.typescriptlang.org/",
    "repository": "https://github.com/microsoft/typescript-go",
    "service": "typescript",
    "ext": "ts",
    "file": "main.ts",
    "build": [
      "tsc --strict --noImplicitReturns --noFallthroughCasesInSwitch --noUncheckedIndexedAccess --noImplicitOverride --noUnusedLocals --noUnusedParameters --noPropertyAccessFromIndexSignature --exactOptionalPropertyTypes --allowUnreachableCode false --allowUnusedLabels false --target es2024 --module nodenext --typeRoots /usr/lib/node_modules/@types --types node --outDir out main.ts"
    ],
    "run": "node out/main.js",
    "version": "echo tsc $(tsc --version) / node $(node --version)"
  },
  "javascript": {
    "name": "JavaScript",
    "homepage": "https://tc39.es/",
    "repository": "https://github.com/tc39/ecma262",
    "service": "javascript",
    "ext": "js",
    "file": "main.js",
    "build": [
      "node --use_strict --check main.js"
    ],
    "run": "node main.js",
    "version": "echo node $(node --version)"
  },
  "python": {
    "name": "Python",
    "homepage": "https://www.python.org/",
    "repository": "https://github.com/python/cpython",
    "service": "python_mypy",
    "ext": "py",
    "file": "main.py",
    "build": [
      "python3 -m py_compile main.py"
    ],
    "run": "python3 main.py",
    "version": "python3 --version",
    "tools": {
      "check": [
        "mypy --strict --warn-unreachable --strict-equality-for-none --enable-error-code possibly-undefined --enable-error-code redundant-expr --enable-error-code truthy-bool --enable-error-code truthy-iterable --enable-error-code unused-awaitable --enable-error-code explicit-override --enable-error-code mutable-override --enable-error-code exhaustive-match --enable-error-code deprecated --cache-dir /dev/null --no-color-output main.py"
      ]
    }
  },
  "ruby": {
    "name": "Ruby",
    "homepage": "https://www.ruby-lang.org/",
    "repository": "https://github.com/ruby/ruby",
    "service": "ruby",
    "ext": "rb",
    "file": "main.rb",
    "build": [
      "ruby -c main.rb"
    ],
    "run": "ruby main.rb",
    "version": "ruby --version",
    "tools": {
      "check": [
        "ruby -wc main.rb"
      ]
    }
  },
  "php": {
    "name": "PHP",
    "homepage": "https://www.php.net/",
    "repository": "https://github.com/php/php-src",
    "service": "php",
    "ext": "php",
    "file": "main.php",
    "build": [
      "php -l main.php"
    ],
    "run": "php -d error_reporting=E_ALL -d display_errors=stderr -d zend.assertions=1 main.php",
    "version": "php --version | head -1",
    "release": {
      "build": [
        "php -l main.php"
      ],
      "run": "php -d error_reporting=E_ALL -d display_errors=stderr -d zend.assertions=-1 main.php"
    }
  },
  "julia": {
    "name": "Julia",
    "homepage": "https://julialang.org/",
    "repository": "https://github.com/JuliaLang/julia",
    "service": "julia",
    "ext": "jl",
    "file": "main.jl",
    "build": [
      "julia --startup-file=no -e 'src = read(\"main.jl\", String); ex = Meta.parseall(src); bad(e) = e isa Expr && (e.head in (:error, :incomplete) || any(bad, e.args)); bad(ex) && (show(ex); exit(1))'"
    ],
    "run": "julia --startup-file=no --check-bounds=yes -t 8 main.jl",
    "version": "julia --version",
    "release": {
      "build": [
        "julia --startup-file=no -e 'src = read(\"main.jl\", String); ex = Meta.parseall(src); bad(e) = e isa Expr && (e.head in (:error, :incomplete) || any(bad, e.args)); bad(ex) && (show(ex); exit(1))'"
      ],
      "run": "julia --startup-file=no -t 8 main.jl"
    }
  },
  "ocaml": {
    "name": "OCaml",
    "homepage": "https://ocaml.org/",
    "repository": "https://github.com/ocaml/ocaml",
    "service": "ocaml",
    "ext": "ml",
    "file": "main.ml",
    "extra_files": {
      "dune": "(executable (name main) (libraries str unix threads.posix re zarith))\n",
      "dune-project": "(lang dune 3.0)\n"
    },
    "build": [
      "dune build ./main.exe 2>&1"
    ],
    "run": "./_build/default/main.exe",
    "version": "ocaml -version",
    "release": {
      "build": [
        "dune build --profile release ./main.exe 2>&1"
      ],
      "run": "./_build/default/main.exe"
    },
    "tools": {
      "check": [
        "ocamlfind ocamlopt -w +a -package str,unix,threads.posix,re,zarith -c -o lint.cmx main.ml"
      ]
    }
  },
  "haskell": {
    "name": "Haskell",
    "homepage": "https://www.haskell.org/",
    "repository": "https://gitlab.haskell.org/ghc/ghc",
    "service": "haskell",
    "ext": "hs",
    "file": "main.hs",
    "build": [
      "ghc -O0 -threaded -package-db /opt/hsdb -o main main.hs"
    ],
    "run": "./main",
    "version": "ghc --version",
    "release": {
      "build": [
        "ghc -O1 -threaded -package-db /opt/hsdb -o main main.hs"
      ],
      "run": "./main"
    },
    "tools": {
      "check": [
        "ghc -Weverything -Wno-missing-safe-haskell-mode -Wno-unsafe -Wno-safe -Wno-implicit-prelude -Wno-missing-import-lists -Wno-missing-export-lists -Wno-missing-local-signatures -Wno-monomorphism-restriction -Wno-missing-deriving-strategies -Wno-prepositive-qualified-module -Wno-missing-kind-signatures -Wno-missing-poly-kind-signatures -Wno-missing-role-annotations -Wno-all-missed-specialisations -Wno-missed-specialisations -Wno-implicit-lift -fno-code -package-db /opt/hsdb main.hs"
      ]
    }
  },
  "clojure": {
    "name": "Clojure",
    "homepage": "https://clojure.org/",
    "repository": "https://github.com/clojure/clojure",
    "service": "clojure",
    "ext": "clj",
    "file": "main.clj",
    "build": [
      "cp /opt/clj/deps.edn . && mkdir -p classes && clojure -M -e \"(compile (quote main))\""
    ],
    "run": "clojure -M -m main",
    "version": "clojure -M -e '(println \"Clojure\" (clojure-version))'",
    "build_trap": "^Execution error"
  }
}
