FROM breakbench:base

RUN curl -fsSL https://pixi.sh/install.sh | sh
ENV PATH="/root/.pixi/bin:${PATH}"

# A fixed workspace so compiling a problem never resolves packages at run time.
RUN mkdir -p /opt/mojo-ws && cd /opt/mojo-ws \
    && printf '[workspace]\nname = "breakbench"\nchannels = ["https://conda.modular.com/max", "conda-forge"]\nplatforms = ["linux-64"]\nversion = "0.1.0"\n\n[dependencies]\nmojo = "*"\nmax = "*"\n' > pixi.toml \
    && pixi install
