use std::env

struct Node {
    value: i64
    next: Option<Node>
}

fn build_and_release(n: i64) -> i64 {
    let mut head: Option<Node> = None
    for i in 0..n {
        head = Some(Node { value: i, next: head })
    }
    n
}

fn main() {
    let n = env::args()[0].to_i64().unwrap()
    build_and_release(n)
    println("done")
}
