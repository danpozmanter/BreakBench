use std::env
use std::sync::{channel, Sender}

fn answer(tx: Sender<Vec<i64>>, seed: i64) -> () {
    tx.send(#[seed; 8192])
}

fn main() {
    let rounds = env::args()[0].to_i64().unwrap()
    for i in 0..rounds {
        let tx, rx = channel()
        spawn(|| answer(tx, i))
        spawn(|| answer(tx, i + 1))
        let first = rx.recv()
    }
    println("done")
}
