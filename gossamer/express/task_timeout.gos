// LEVEL: STD

use std::{process, sync, time}

fn main() {
    let tx, rx = sync::channel()
    spawn(|| { time::sleep(5000); tx.send(1) })
    select {
        Some(_) = rx.recv() => println("done"),
        _ = time::after(time::Duration::from_millis(100)) => println("timed out"),
    }
    process::exit(0)
}
