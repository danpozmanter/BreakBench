// LEVEL: STD

use std::errors
use std::process::Command

fn main() -> Result<(), errors::Error> {
    let mut child = Command::new("sleep").arg("10").spawn()?
    let done = child.wait_timeout(100)?
    if done.is_none() {
        child.kill()
        child.wait()?
        println("killed")
    } else {
        println("finished")
    }
    Ok(())
}
