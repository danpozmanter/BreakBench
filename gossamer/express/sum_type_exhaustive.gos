// LEVEL: LANGUAGE

enum Shape {
    Circle(f64)
    Square(f64)
}

fn name(s: Shape) -> String {
    match s {
        Shape::Circle(_) => "circle",
        Shape::Square(_) => "square",
    }
}

fn bad(s: Shape) -> String { match s { Shape::Circle(_) => "circle" } } // REJECT!

fn main() {
    println(bad(Shape::Circle(1.0))) // REJECT!
    println(name(Shape::Circle(1.0)))
}
