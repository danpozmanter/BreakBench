use std::fs

const LOCK: String = "/tmp/bb_scratch/reader.lock"

struct Rows {
    lines: Vec<String>
    next_index: i64 = 0
}

impl Iterator for Rows {
    type Item = String

    fn next(&mut self) -> Option<String> {
        if self.next_index < self.lines.len() {
            let line = self.lines[self.next_index]
            self.next_index += 1
            return Some(line)
        }
        let _ = fs::remove_file(LOCK)
        None
    }
}

fn rows() -> Rows {
    let _ = fs::write(LOCK, "".bytes())
    Rows { lines: #["alpha", "beta", "gamma"] }
}

fn main() {
    for line in rows() {
        println(line)
        break // BREAK!
    }
}
