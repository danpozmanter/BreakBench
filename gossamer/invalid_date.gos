use std::env
use std::time
use std::time::Location

fn main() {
    let args = env::args()
    let parts = time::CivilTime {
        year: args[0].to_i64().unwrap_or(0),
        month: args[1].to_i64().unwrap_or(0),
        day: args[2].to_i64().unwrap_or(0),
        hour: 0, minute: 0, second: 0, nanosecond: 0, offset_seconds: 0, weekday: 0,
    }
    // resolve answers a Result, so the date is reached only through a check.
    match Location::utc().resolve(parts) {
        Ok(_) => println(f"{parts.year:04}-{parts.month:02}-{parts.day:02}")
        Err(_) => println("invalid")
    }
}
