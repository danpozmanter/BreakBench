struct Order {
    customer: i64
    day: i64
}

fn main() {
    let mut orders = #[]
    for day in 0..200 { orders.push(Order { customer: day * 7 % 5, day }) }
    // UNDEFINED: sort_by_key does not document whether equal keys keep their order
    orders.sort_by_key(|o| o.customer) // CONTROL! orders.sort_by_key(|o| (o.customer, o.day))
    let mut kept = true
    for i in 1..orders.len() {
        if orders[i].customer == orders[i - 1].customer && orders[i].day < orders[i - 1].day { kept = false }
    }
    println(if kept { "kept" } else { "scrambled" })
}
