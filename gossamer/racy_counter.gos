use std::sync::Shared

fn main() {
    let mut count = 0 // BREAK!
    let safe = Shared::new(0)
    let a = spawn(|| { for _ in 0..1000000 { count += 1 } }) // CONTROL! let a = spawn(|| { for _ in 0..1000000 { safe.update(|n| n + 1) } })
    let b = spawn(|| { for _ in 0..1000000 { count += 1 } }) // CONTROL! let b = spawn(|| { for _ in 0..1000000 { safe.update(|n| n + 1) } })
    a.join().unwrap()
    b.join().unwrap()
    println(f"{count}") // CONTROL! println(f"{safe.get()}")
}
