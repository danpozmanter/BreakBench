use std::env

enum Color {
    Red
    Green
    Blue
}

fn name(c: Color) -> String {
    match c {
        Color::Red => "red",
        Color::Green => "green",
        // CONTROL! Color::Blue => "blue",
    }
}

fn main() {
    let i = env::args()[0].to_i64().unwrap()
    let colors = [Color::Red, Color::Green, Color::Blue]
    println(name(colors[i]))
}
