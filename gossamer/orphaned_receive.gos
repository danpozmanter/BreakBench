use std::sync::channel

fn main() {
    let tx, rx = channel()
    spawn(|| {
        let n = "x".to_i64().unwrap() // CONTROL! match "x".to_i64() { Some(n) => tx.send(n), None => tx.close() }
        tx.send(n) // BREAK!
    })
    println(f"{rx.recv().unwrap()}") // CONTROL! match rx.recv() { Some(n) => println(f"{n}"), None => println("failed") }
}
