use std::sync::channel

fn main() {
    let tx, rx = channel()
    spawn(|| {
        // to_i64 answers an Option, so the worker checks it before sending.
        let Some(n) = "x".to_i64() else { return } // CONTROL! let Some(n) = "x".to_i64() else { tx.close(); return }
        tx.send(n)
    })
    // recv answers an Option, so main checks it too.
    match rx.recv() {
        Some(n) => println(f"{n}"),
        None => println("failed"),
    }
}
