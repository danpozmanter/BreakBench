// Gossamer has no conversion from an integer to an enum; the match below must handle every other value.
use std::env

enum Color {
    Red
    Green
    Blue
}

fn color(n: i64) -> Option<Color> {
    match n {
        0 => Some(Color::Red),
        1 => Some(Color::Green),
        2 => Some(Color::Blue),
        _ => None,
    }
}

fn main() {
    let n = env::args()[0].to_i64().unwrap()
    println("before")
    match color(n) {
        Some(c) => println(f"{c}"),
        None => println("invalid"),
    }
}
