use std::{env, strings}

fn main() {
    let n = env::args()[0].to_i64().unwrap()
    let letters = "abcdefghijklmnopqrstuvwxyz"
    let mut heads: Vec<Vec<u8>> = #[]
    let mut prefixes: Vec<String> = #[]
    for i in 0..n {
        let buf = #[(i % 256) as u8; 32768]
        heads.push(buf[0..16])
        let big = strings::repeat(letters.substring(i % 26, i % 26 + 1), 32768)
        prefixes.push(big.substring(0, 16))
    }
    println(f"{heads.len()}")
}
