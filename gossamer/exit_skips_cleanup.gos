use std::{env, fs, process}

const LOCK: String = "/tmp/bb_scratch/run.lock"

fn check_args() -> bool {
    if env::args().contains("--version") {
        println("1.0")
        process::exit(0) // BREAK!
        // CONTROL! return true
    }
    false
}

fn main() {
    let _ = fs::write(LOCK, "".bytes())
    defer fs::remove_file(LOCK)
    if check_args() {
        return
    }
    println("working")
}
