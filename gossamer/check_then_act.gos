use std::sync::{Mutex, Shared}

fn main() {
    let state_lock = Mutex::new()
    let gate_lock = Mutex::new()
    let claimed = Shared::new(0)
    let winners = Shared::new(0)
    let arrivals = Shared::new(0)
    let mut handles = #[]
    for _ in 0..2 {
        handles.push(spawn(|| {
            state_lock.lock()
            let available = claimed.get() == 0 // BREAK!
            state_lock.unlock()
            // CONTROL! let available = claimed.get() == 0; if available { claimed.update(|_| 1) }
            gate_lock.lock(); arrivals.update(|n| n + 1); gate_lock.unlock()
            while true {
                gate_lock.lock(); let open = arrivals.get() == 2; gate_lock.unlock()
                if open { break }
            }
            if available {
                state_lock.lock(); claimed.update(|_| 1); winners.update(|n| n + 1); state_lock.unlock()
            }
        }))
    }
    for h in handles { let _ = h.join() }
    println(f"{winners.get()}")
}
