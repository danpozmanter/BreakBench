use std::sync::{Mutex, Shared}

fn post(lock: Mutex, debits: Shared<i64>, credits: Shared<i64>) -> () {
    let guard = lock.lock()
    debits.update(|d| d + 50)
    if debits.get() > 0 { panic("crash mid-update") } // CONTROL! if debits.get() > 0 { debits.update(|d| d - 50); guard.unlock(); panic("crash mid-update") }
    credits.update(|c| c + 50)
}

fn main() {
    let lock = Mutex::new()
    let debits = Shared::new(0)
    let credits = Shared::new(0)
    let worker = spawn(|| post(lock, debits, credits))
    if worker.join().is_err() { eprintln("worker failed") }
    let guard = lock.lock()
    println(if debits.get() == credits.get() { "balanced" } else { "unbalanced" })
}
